# This is an example environment file for the blockchain insight application.
RPC_URL=https://google.com

# hex private key of the hot wallet that signs withdrawals (testnet only, never a real key)
PRIVATE_KEY=

# the ERC20 contract that /send transfers (e.g. Sepolia USDC 0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238)
TOKEN_ADDRESS=

# optional: an archive node (e.g. Infura); asked only when RPC_URL fails, e.g. pruned old blocks
ARCHIVE_RPC_URL=

# the name of the blockchain network (e.g., ethereum-mainnet, ethereum-ropsten, etc.)
NETWORK_NAME=ethereum-XXXX

# the timeout in seconds for RPC requests
TIMEOUT_SEC=number

# blocks on top of a deposit before it is confirmed (default 12)
CONFIRMATIONS=12

# postgres connection string (from the host; docker compose overrides it for the container)
DATABASE_URL=postgres://insight:insight@localhost:5433/ledger?sslmode=disable
